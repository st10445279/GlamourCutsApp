<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/tvItemService"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#3D2B1F"/>

    <TextView
        android:id="@+id/tvItemClientName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#8B6651"/>

    <TextView
        android:id="@+id/tvItemDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#9A8E84"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tvItemStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="italic"
        android:textColor="#C4957A"
        android:layout_marginTop="4dp"/>

    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnItemCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:textSize="11sp"
            android:padding="0dp"
            android:textColor="#FAF7F2"
            android:backgroundTint="#8B6651"/>

        <Button
            android:id="@+id/btnItemUpdate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Update"
            android:textSize="11sp"
            android:padding="0dp"
            android:textColor="#FAF7F2"
            android:backgroundTint="#3D2B1F"
            android:layout_marginStart="4dp"/>

        <Button
            android:id="@+id/btnItemRemind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SMS"
            android:textSize="11sp"
            android:padding="0dp"
            android:textColor="#FAF7F2"
            android:backgroundTint="#C4957A"
            android:layout_marginStart="4dp"
            android:visibility="gone"/>
    </LinearLayout>

</LinearLayout>

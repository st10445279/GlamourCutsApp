<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textSize="28sp"
            android:textColor="#3D2B1F"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Profile Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#E8D5C4"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/account_settings"
                    android:textSize="18sp"
                    android:textColor="#3D2B1F"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvRoleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Role: Client"
                    android:textSize="14sp"
                    android:textColor="#8B6651"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/etSettingsUsername"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="@string/username"
                        android:background="#FAF7F2"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="text"
                        android:autofillHints="username" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/etSettingsPhone"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="@string/phone_number"
                        android:background="#FAF7F2"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="phone"
                        android:autofillHints="phone" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true">

                    <EditText
                        android:id="@+id/etSettingsPassword"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="@string/new_password_optional"
                        android:background="#FAF7F2"
                        android:paddingStart="12dp"
                        android:paddingEnd="48dp"
                        android:inputType="textPassword"
                        android:autofillHints="password" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/save_changes"
                    android:textColor="#FAF7F2"
                    android:backgroundTint="#3D2B1F" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Language Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#E8D5C4"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/language_settings"
                    android:textSize="18sp"
                    android:textColor="#3D2B1F"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_language"
                    android:textSize="14sp"
                    android:textColor="#8B6651"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#FAF7F2"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnApplyLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/apply_language"
                    android:textColor="#3D2B1F"
                    android:backgroundTint="#E8D5C4" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Help & Support Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#E8D5C4"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/help_and_support"
                    android:textSize="18sp"
                    android:textColor="#3D2B1F"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browse user documentation, FAQs, or submit a support ticket."
                    android:textSize="14sp"
                    android:textColor="#8B6651"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnOpenHelpCenter"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/help_center"
                    android:textColor="#3D2B1F"
                    android:backgroundTint="#E8D5C4" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnSettingsBack"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/back_to_home"
            android:textColor="#8B6651"
            android:backgroundTint="#FAF7F2" />

    </LinearLayout>
</ScrollView>
